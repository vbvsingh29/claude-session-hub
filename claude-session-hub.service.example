# Copy to ~/.config/systemd/user/claude-session-hub.service, edit paths, then:
#   systemctl --user daemon-reload && systemctl --user enable --now claude-session-hub
[Unit]
Description=Claude Session Hub

[Service]
ExecStart=/usr/bin/node %h/claude-session-hub/server.js
Restart=always
Environment=IDLE_DAYS=30
# Environment=JIRA_BASE=https://yourco.atlassian.net/browse/
# Environment=TICKET_PREFIXES=ABC,PROJ

[Install]
WantedBy=default.target
